*!*	_screen.TitleBar = 0 
*!*	_screen.BackColor = RGB(137,165,237)
*!*	_screen.WindowType= 1
*!*	_screen.BorderStyle= 2  
*!*	SET DEFAULT TO (ADDBS(JUSTPATH(SYS(16))))
*!*	RELEASE APP_GLOBAL
*!*	PUBLIC APP_GLOBAL

*!*	RELEASE VirtualUI
*!*	PUBLIC VirtualUI
*!*	SET ASSERTS ON
*!*	ASSERT .f.
*!*	VirtualUI=CREATEOBJECT("Thinfinity.VirtualUI")
